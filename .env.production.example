# ==============================================================================
# Basista Oil Traders - Production Environment Variables (.env.production)
# ==============================================================================
# DO NOT COMMIT THE ACTUAL .env OR .env.production FILE TO VERSION CONTROL
# File permissions should be restricted: chmod 600 /var/www/basista_oil/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core & Security Settings
# ------------------------------------------------------------------------------
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=generate-a-strong-random-50-character-string-here-in-production

# Strictly False for production deployments
DEBUG=False

# Comma-separated list of fully qualified domain names and server IPs
ALLOWED_HOSTS=petrol.basistaoil.com.np,www.petrol.basistaoil.com.np,127.0.0.1

# Trusted origins for CSRF validation (scheme + domain)
CSRF_TRUSTED_ORIGINS=https://petrol.basistaoil.com.np,https://www.petrol.basistaoil.com.np

# HTTPS and Cookie Security (Enforced on production)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ------------------------------------------------------------------------------
# 2. Production PostgreSQL Database
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=petrol_station_prod_db
DB_USER=petrol_db_user
DB_PASSWORD=USE_A_STRONG_RANDOM_POSTGRES_PASSWORD_HERE
DB_HOST=127.0.0.1
DB_PORT=5432
CONN_MAX_AGE=60

# ------------------------------------------------------------------------------
# 3. Logging & Performance
# ------------------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 4. Station Profile Information
# ------------------------------------------------------------------------------
STATION_NAME_EN=Basista Oil Traders
STATION_NAME_NE=बसिस्ट आयल ट्रेडर्स
STATION_LOCATION=Kathmandu, Nepal
STATION_PAN_VAT=601234567

# ------------------------------------------------------------------------------
# 5. Localization & Timezone
# ------------------------------------------------------------------------------
TIME_ZONE=Asia/Kathmandu
DEFAULT_LANGUAGE=ne
