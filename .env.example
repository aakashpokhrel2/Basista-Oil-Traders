# ===============================================================
# Petrol Station Management System - Environment Variables
# Copy this file to .env and adjust values for your environment
# ===============================================================

# Django Core Settings
SECRET_KEY=django-insecure-change-this-to-a-very-secure-random-key-in-production-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# HTTPS and Cookie Security (Set to True in production with SSL)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Database Configuration (PostgreSQL by default)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=petrol_station_db
DB_USER=petrol_admin
DB_PASSWORD=petrol_secure_password_nepal_2026
DB_HOST=localhost
DB_PORT=5432
CONN_MAX_AGE=60

# Station Profile Information
STATION_NAME_EN=Basista Oil Traders
STATION_NAME_NE=बसिस्ट आयल ट्रेडर्स
STATION_LOCATION=Kathmandu, Nepal
STATION_PAN_VAT=601234567

# Localization & Timezone
TIME_ZONE=Asia/Kathmandu
DEFAULT_LANGUAGE=en
DJANGO_LOG_LEVEL=INFO
